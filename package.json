{
  "name": "chriselkins.io",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "images": "node --env-file=.env scripts/optimize-images.mjs",
    "deploy": "bash scripts/deploy.sh",
    "deploy:infra": "aws cloudformation deploy --region us-east-1 --stack-name chriselkins-io-site --template-file infra/site.yaml --tags Project=chriselkins.io --no-fail-on-empty-changeset",
    "astro": "astro"
  },
  "allowScripts": {
    "esbuild": true
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "astro": "^7.3.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "fflate": "^0.8.3",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
