---
import Mark from './Mark.astro';
import { profile } from '../lib/profile';

const nav = [
  { href: '/about/', label: 'About' },
  { href: '/work/', label: 'Work' },
  { href: '/projects/', label: 'Projects' },
  { href: '/writing/', label: 'Writing' },
  { href: '/contact/', label: 'Contact' },
];
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label={`${profile.name}, home`}>
      <Mark />
      <span>{profile.name}</span>
    </a>
    <nav aria-label="Main">
      <ul role="list" class="nav">
        {
          nav.map(({ href, label }) => (
            <li>
              <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 1.375rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.75rem;
    font-size: 0.9375rem;
  }

  .nav a {
    position: relative;
    display: inline-block;
    padding-block: 0.25rem;
    color: var(--text-2);
    transition: color 0.15s ease;
  }

  .nav a:hover {
    color: var(--text);
  }

  .nav a[aria-current='page'] {
    color: var(--text);
  }

  .nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1px;
    background: var(--teal);
  }

  @media (max-width: 560px) {
    .site-header__inner {
      padding-block: 1.125rem 0.75rem;
    }

    .site-header nav {
      flex-basis: 100%;
    }

    .nav {
      gap: 0.25rem 1.25rem;
    }
  }
</style>
