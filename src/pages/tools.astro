---
import { existsSync } from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import { IMPERIAL, METRIC, SLIDER_MAX_LOG, SLIDER_MIN_LOG, SLIDER_STEPS, UNITS, convert, formatNumber, metersToSlider } from '../lib/length';
import { COLDEST_C, HOTTEST_C, formatTemperature, toCelsius, toFahrenheit } from '../lib/temperature';
import { describeSubnet, formatIPv4, maskFromBits, parseIPv4 } from '../lib/cidr';

const zones = [
  { id: 'eastern', label: 'Eastern', tz: 'America/New_York' },
  { id: 'central', label: 'Central', tz: 'America/Chicago' },
  { id: 'mountain', label: 'Mountain', tz: 'America/Denver' },
  { id: 'pacific', label: 'Pacific', tz: 'America/Los_Angeles' },
  { id: 'india', label: 'India', tz: 'Asia/Kolkata', abbr: 'IST' },
  { id: 'utc', label: 'UTC', tz: 'UTC' },
];

// The All zones dialog: the card's zones plus major cities around the world, west to east.
const allZones = [
  { id: 'honolulu', label: 'Honolulu', tz: 'Pacific/Honolulu' },
  { id: 'pacific', label: 'Pacific', tz: 'America/Los_Angeles' },
  // Baja California Sur keeps UTC-7 all year, so it matches Mountain in winter and Pacific in summer.
  { id: 'san-jose-del-cabo', label: 'San José del Cabo', tz: 'America/Mazatlan' },
  { id: 'mountain', label: 'Mountain', tz: 'America/Denver' },
  { id: 'mexico-city', label: 'Mexico City', tz: 'America/Mexico_City' },
  { id: 'central', label: 'Central', tz: 'America/Chicago' },
  { id: 'eastern', label: 'Eastern', tz: 'America/New_York' },
  { id: 'sao-paulo', label: 'São Paulo', tz: 'America/Sao_Paulo' },
  { id: 'utc', label: 'UTC', tz: 'UTC' },
  { id: 'london', label: 'London', tz: 'Europe/London' },
  { id: 'madrid', label: 'Madrid', tz: 'Europe/Madrid' },
  { id: 'paris', label: 'Paris', tz: 'Europe/Paris' },
  { id: 'johannesburg', label: 'Johannesburg', tz: 'Africa/Johannesburg' },
  { id: 'istanbul', label: 'Istanbul', tz: 'Europe/Istanbul' },
  { id: 'dubai', label: 'Dubai', tz: 'Asia/Dubai' },
  { id: 'india', label: 'India', tz: 'Asia/Kolkata', abbr: 'IST' },
  { id: 'bangkok', label: 'Bangkok', tz: 'Asia/Bangkok' },
  { id: 'singapore', label: 'Singapore', tz: 'Asia/Singapore' },
  { id: 'tokyo', label: 'Tokyo', tz: 'Asia/Tokyo' },
  { id: 'sydney', label: 'Sydney', tz: 'Australia/Sydney' },
  { id: 'auckland', label: 'Auckland', tz: 'Pacific/Auckland' },
];

// Sliders run 00:00 to 23:55 in 5-minute steps.
const SLIDER_MAX_MINUTES = 1435;
const hourTicks = [0, 3, 6, 9, 12, 15, 18, 21].map((h) => ({
  label: h === 0 ? '12a' : h === 12 ? '12p' : h < 12 ? `${h}a` : `${h - 12}p`,
  x: ((h * 60) / SLIDER_MAX_MINUTES) * 100,
}));

const logPosition = (meters: number) => ((Math.log10(meters) - SLIDER_MIN_LOG) / (SLIDER_MAX_LOG - SLIDER_MIN_LOG)) * 100;
const metricTicks = [
  { label: '1 mm', m: 1e-3 },
  { label: '1 cm', m: 1e-2, minor: true },
  { label: '10 cm', m: 0.1, minor: true },
  { label: '1 m', m: 1 },
  { label: '10 m', m: 10, minor: true },
  { label: '100 m', m: 100, minor: true },
  { label: '1 km', m: 1e3 },
  { label: '10 km', m: 1e4, minor: true },
  { label: '100 km', m: 1e5, minor: true },
  { label: '1,000 km', m: 1e6 },
].map((t) => ({ ...t, x: logPosition(t.m) }));
const imperialTicks = [
  { label: '1 in', m: 0.0254 },
  { label: '1 ft', m: 0.3048 },
  { label: '1 mi', m: 1609.344 },
  { label: '100 mi', m: 160934.4 },
].map((t) => ({ ...t, x: logPosition(t.m) }));

// Start the length converter at 1 meter so it renders filled in, even before JS runs.
const initial = (unit: keyof typeof UNITS) => formatNumber(convert(1, 'm', unit));

// The temperature converter starts at room temperature.
const START_CELSIUS = 20;

// Its slider has Fahrenheit marks above and Celsius below, like the length slider's imperial and metric.
const temperaturePosition = (celsius: number) => ((celsius - COLDEST_C) / (HOTTEST_C - COLDEST_C)) * 100;
// Show Table lists: -20 to 50 °C in 5° steps, which are whole degrees in both scales, and 1 to 10 cm, m,
// and km, side by side, in inches, feet, and miles.
const temperatureTable = Array.from({ length: 15 }, (_, i) => -20 + i * 5).map((c) => [c, formatTemperature(toFahrenheit(c))]);
const lengthTables = (
  [
    ['cm', 'in'],
    ['m', 'ft'],
    ['km', 'mi'],
  ] as const
).map(([from, to]) => ({
  from: UNITS[from].name,
  to: UNITS[to].name,
  rows: Array.from({ length: 10 }, (_, i) => i + 1).map((n) => [n, convert(n, from, to).toFixed(2)]),
}));

// Minor marks drop out on narrow screens, leaving -40, 0, 40, 80 °C and 0, 100, 200 °F.
const celsiusTicks = [-40, -20, 0, 20, 40, 60, 80, 100].map((c) => ({
  label: `${c} °C`,
  x: temperaturePosition(c),
  minor: c % 40 !== 0,
}));
const fahrenheitTicks = [0, 50, 100, 150, 200].map((f) => ({
  label: `${f} °F`,
  x: temperaturePosition(toCelsius(f)),
  minor: f % 100 !== 0,
}));

// The subnet calculator starts on a typical home network, filled in before the script runs.
const CIDR_START = { ip: '192.168.1.10', bits: 24 };
const cidrStart = describeSubnet(parseIPv4(CIDR_START.ip)!, CIDR_START.bits);
const maskOptions = Array.from({ length: 33 }, (_, bits) => ({ bits, netmask: formatIPv4(maskFromBits(bits)) }));
const cidrRows = [
  { key: 'network', label: 'Network' },
  { key: 'netmask', label: 'Netmask' },
  { key: 'wildcard', label: 'Wildcard' },
  { key: 'range', label: 'Address range' },
  { key: 'usable', label: 'Usable hosts' },
  { key: 'count', label: 'Addresses' },
] as const;

// Prompt boxes start a new chat. Gemini has no prompt parameter of its own; the new tab extension
// fills its box from ?prompt=.
const assistants = [
  { id: 'chatgpt', label: 'ChatGPT', url: 'https://chatgpt.com/?prompt=' },
  { id: 'gemini', label: 'Gemini', url: 'https://gemini.google.com/app?prompt=' },
  { id: 'claude', label: 'Claude', url: 'https://claude.ai/new?q=' },
  { id: 'perplexity', label: 'Perplexity', url: 'https://www.perplexity.ai/search?q=' },
  { id: 'higgsfield-image', label: 'Higgsfield Image', url: 'https://higgsfield.ai/ai/image?prompt=', placeholder: 'Describe an image' },
  { id: 'higgsfield-video', label: 'Higgsfield Video', url: 'https://higgsfield.ai/ai/video?prompt=', placeholder: 'Describe a video' },
];

// The Safari extension is signed and notarized on my Mac (npm run safari), so its link only shows
// once that zip is committed.
const hasSafari = existsSync(path.join(process.cwd(), 'public/downloads/chris-new-tab-safari.zip'));

// Links along the top, beside the Conversions button.
const toolLinks = [
  { label: 'IT Tools', href: 'https://it-tools.tech/' },
  { label: 'Dev Tools', href: 'https://devtoys.pro/' },
];
---

<Base title="Tools" description="Time zones, length conversions, and search." noindex hideHeader hideFooter>
  <div class="container tools">
    <h1 class="visually-hidden">Tools</h1>

    <div class="topbar">
      {
        toolLinks.map((l) => (
          <a class="button button--small" href={l.href} rel="noreferrer">
            {l.label}
          </a>
        ))
      }
      <button class="button button--small" type="button" id="conversions-open" aria-haspopup="dialog">Conversions</button>
    </div>

    <section class="panel" aria-labelledby="tz-title">
      <div class="panel__head">
        <h2 class="panel__title" id="tz-title">Time zones</h2>
        <div class="panel__actions">
          <span class="clock" aria-live="polite" data-clock></span>
          <span class="live" data-live><span class="live__dot" aria-hidden="true"></span>Live</span>
          <button class="button button--small" type="button" data-now>Now</button>
          <button class="button button--small" type="button" id="zones-open" aria-haspopup="dialog">All zones</button>
        </div>
        <p class="panel__hint" id="tz-hint">
          Type into any field (<kbd>3pm</kbd>, <kbd>9/27 9:30am</kbd>, <kbd>2026-09-26 14:30</kbd>) or drag a slider.
        </p>
      </div>

      <div class="tz">
        {
          zones.map((z) => (
            <div class="tz__row" data-zone={z.tz} data-abbr={z.abbr}>
              <div class="tz__label">
                <label for={`tz-${z.id}`}>{z.label}</label>
                <span class="tz__meta" data-meta></span>
              </div>
              <input
                class="field tz__input"
                id={`tz-${z.id}`}
                type="text"
                autocomplete="off"
                spellcheck="false"
                aria-describedby="tz-hint"
                data-input
              />
              <span class="tz__friendly" data-friendly></span>
              <input
                class="tz__slider"
                type="range"
                min="0"
                max={SLIDER_MAX_MINUTES}
                step="5"
                aria-label={`${z.label} time of day`}
                data-slider
              />
            </div>
          ))
        }
        <div class="tz__row tz__row--ticks" aria-hidden="true">
          <div class="ticks tz__ticks">
            {hourTicks.map((t) => <span style={`--x: ${t.x}%`}>{t.label}</span>)}
          </div>
        </div>
        <div class="tz__row tz__row--unix" data-unix>
          <div class="tz__label">
            <label for="tz-unix">Unix</label>
            <span class="tz__meta">seconds or ms</span>
          </div>
          <input
            class="field tz__input"
            id="tz-unix"
            type="text"
            inputmode="numeric"
            autocomplete="off"
            spellcheck="false"
            data-input
          />
          <span class="tz__friendly tz__unix-detail" data-detail></span>
        </div>
      </div>
    </section>

    <dialog class="dialog" id="zones" aria-labelledby="zones-title">
      <div class="dialog__body">
        <div class="panel__head">
          <h2 class="dialog__title" id="zones-title">All time zones</h2>
          <div class="panel__actions">
            <span class="clock" aria-live="polite" data-clock></span>
            <span class="live" data-live><span class="live__dot" aria-hidden="true"></span>Live</span>
            <button class="button button--small" type="button" data-now>Now</button>
            <button class="button button--small" type="button" id="zones-close">Close</button>
          </div>
          <p class="panel__hint" id="zones-hint">
            Type into any field (<kbd>3pm</kbd>, <kbd>9/27 9:30am</kbd>, <kbd>2026-09-26 14:30</kbd>) or drag a slider.
          </p>
        </div>

        <div class="tz">
          {
            allZones.map((z) => (
              <div class="tz__row" data-zone={z.tz} data-abbr={z.abbr}>
                <div class="tz__label">
                  <label for={`zones-${z.id}`}>{z.label}</label>
                  <span class="tz__meta" data-meta></span>
                </div>
                <input
                  class="field tz__input"
                  id={`zones-${z.id}`}
                  type="text"
                  autocomplete="off"
                  spellcheck="false"
                  aria-describedby="zones-hint"
                  data-input
                />
                <span class="tz__friendly" data-friendly></span>
                <input
                  class="tz__slider"
                  type="range"
                  min="0"
                  max={SLIDER_MAX_MINUTES}
                  step="5"
                  aria-label={`${z.label} time of day`}
                  data-slider
                />
              </div>
            ))
          }
          <div class="tz__row tz__row--ticks" aria-hidden="true">
            <div class="ticks tz__ticks">
              {hourTicks.map((t) => <span style={`--x: ${t.x}%`}>{t.label}</span>)}
            </div>
          </div>
          <div class="tz__row tz__row--unix" data-unix>
            <div class="tz__label">
              <label for="zones-unix">Unix</label>
              <span class="tz__meta">seconds or ms</span>
            </div>
            <input
              class="field tz__input"
              id="zones-unix"
              type="text"
              inputmode="numeric"
              autocomplete="off"
              spellcheck="false"
              data-input
            />
            <span class="tz__friendly tz__unix-detail" data-detail></span>
          </div>
        </div>
      </div>
    </dialog>

    <section class="ask" aria-label="Ask an assistant">
      {
        assistants.map((a) => (
          <form class="search__form ask__form" data-prompt-url={a.url}>
            <label class="search__engine" for={`ask-${a.id}`}>
              {a.label}
            </label>
            <textarea
              class="ask__input"
              id={`ask-${a.id}`}
              name="prompt"
              rows="1"
              placeholder={a.placeholder ?? `Ask ${a.label}`}
              enterkeyhint="send"
              required
            />
            <button class="search__go" type="submit" aria-label={`Ask ${a.label}`}>
              <span aria-hidden="true">↗</span>
            </button>
          </form>
        ))
      }
    </section>

    <section class="search" aria-label="Web search">
      <form class="search__form" action="https://www.google.com/search" method="get" rel="noreferrer" role="search">
        <label class="search__engine" for="q-google">Google</label>
        <input class="search__input" id="q-google" name="q" type="search" placeholder="Search" enterkeyhint="search" autocomplete="off" required autofocus data-suggest="google" />
        <button class="search__go" type="submit" aria-label="Search Google">
          <span aria-hidden="true">↗</span>
        </button>
      </form>
      <form class="search__form" role="search">
        <label class="search__engine" for="q-youtube">YouTube</label>
        <input class="search__input" id="q-youtube" name="search_query" type="search" placeholder="Search" enterkeyhint="search" autocomplete="off" required data-suggest="youtube" />
        <button class="search__go" type="submit" aria-label="Search YouTube">
          <span aria-hidden="true">↗</span>
        </button>
      </form>
      <form class="search__form" action="https://duckduckgo.com/" method="get" rel="noreferrer" role="search">
        <label class="search__engine" for="q-ddg">DuckDuckGo</label>
        <input class="search__input" id="q-ddg" name="q" type="search" placeholder="Search" enterkeyhint="search" autocomplete="off" required data-suggest="duckduckgo" />
        <button class="search__go" type="submit" aria-label="Search DuckDuckGo">
          <span aria-hidden="true">↗</span>
        </button>
      </form>
    </section>

    <p class="extension">
      <a class="extension__link" href="/downloads/chris-new-tab.zip" download>
        Chrome new tab extension <span aria-hidden="true">↓</span>
      </a>
      <span>
        Unzip it, open <code>chrome://extensions</code>, turn on Developer mode, choose Load unpacked, and select the
        <code>chris-new-tab</code> folder.
      </span>
    </p>

    {hasSafari && (
      <p class="extension">
        <a class="extension__link" href="/downloads/chris-new-tab-safari.zip" download>
          Safari new tab extension <span aria-hidden="true">↓</span>
        </a>
        <span>
          Move Chris New Tab to Applications and open it once. In Safari Settings, turn it on under Extensions, allow it
          on gemini.google.com, and choose it under General for new windows and tabs. Needs Safari 18.4 or later.
        </span>
      </p>
    )}

    <dialog class="dialog" id="conversions" aria-labelledby="conversions-title">
      <div class="dialog__body">
        <div class="dialog__head">
          <h2 class="dialog__title" id="conversions-title">Conversions</h2>
          <button class="button button--small" type="button" id="conversions-close">Close</button>
        </div>

        <section class="panel" aria-labelledby="len-title">
          <div class="panel__head">
            <h3 class="panel__title" id="len-title">Length</h3>
            <div class="panel__actions">
              <button class="button button--small" type="button" aria-expanded="false" aria-controls="len-table" data-table-toggle>Show Table</button>
            </div>
          </div>

          <div class="len">
            <fieldset class="len__group len__group--metric">
              <legend class="eyebrow">Metric</legend>
              <div class="len__fields">
                {
                  METRIC.map((u) => (
                    <label class="unit">
                      <span class="unit__name">{UNITS[u].name}</span>
                      <span class="unit__box">
                        <input class="unit__input" type="text" inputmode="decimal" autocomplete="off" spellcheck="false" value={initial(u)} data-unit={u} />
                        <span class="unit__suffix">{u}</span>
                      </span>
                    </label>
                  ))
                }
              </div>
            </fieldset>
            <fieldset class="len__group len__group--imperial">
              <legend class="eyebrow">Imperial</legend>
              <div class="len__fields">
                {
                  IMPERIAL.map((u) => (
                    <label class="unit">
                      <span class="unit__name">{UNITS[u].name}</span>
                      <span class="unit__box">
                        <input class="unit__input" type="text" inputmode="decimal" autocomplete="off" spellcheck="false" value={initial(u)} data-unit={u} />
                        <span class="unit__suffix">{u}</span>
                      </span>
                    </label>
                  ))
                }
              </div>
            </fieldset>
          </div>

          <div class="len__scale">
            <div class="ticks ticks--imperial" aria-hidden="true">
              {imperialTicks.map((t) => <span style={`--x: ${t.x}%`}>{t.label}</span>)}
            </div>
            <input
              class="len__slider"
              id="len-slider"
              type="range"
              min="0"
              max={SLIDER_STEPS}
              step="1"
              value={metersToSlider(1)}
              aria-label="Length on a log scale from 1 millimeter to 1,000 kilometers"
            />
            <div class="ticks ticks--metric" aria-hidden="true">
              {metricTicks.map((t) => <span class:list={{ minor: t.minor }} style={`--x: ${t.x}%`}>{t.label}</span>)}
            </div>
          </div>

          <div class="convert-table" id="len-table" hidden>
            <div class="convert-table__grid">
              {
                lengthTables.map((t) => (
                  <table>
                    <caption class="visually-hidden">{t.from} to {t.to.toLowerCase()}</caption>
                    <thead>
                      <tr><th scope="col">{t.from}</th><th scope="col">{t.to}</th></tr>
                    </thead>
                    <tbody>
                      {t.rows.map(([n, v]) => <tr><td>{n}</td><td>{v}</td></tr>)}
                    </tbody>
                  </table>
                ))
              }
            </div>
          </div>
        </section>

        <div class="conversions__row">
          <section class="panel" aria-labelledby="temp-title">
            <div class="panel__head">
              <h3 class="panel__title" id="temp-title">Temperature</h3>
              <div class="panel__actions">
                <button class="button button--small" type="button" aria-expanded="false" aria-controls="temp-table" data-table-toggle>Show Table</button>
              </div>
            </div>

            <div class="temp">
              <label class="unit">
                <span class="unit__name">Celsius</span>
                <span class="unit__box">
                  <input class="unit__input" id="temp-c" type="text" autocomplete="off" spellcheck="false" value={START_CELSIUS} />
                  <span class="unit__suffix">°C</span>
                </span>
              </label>
              <label class="unit">
                <span class="unit__name">Fahrenheit</span>
                <span class="unit__box">
                  <input
                    class="unit__input"
                    id="temp-f"
                    type="text"
                    autocomplete="off"
                    spellcheck="false"
                    value={formatTemperature(toFahrenheit(START_CELSIUS))}
                  />
                  <span class="unit__suffix">°F</span>
                </span>
              </label>
            </div>

            <div class="temp__scale">
              <div class="ticks ticks--imperial" aria-hidden="true">
                {fahrenheitTicks.map((t) => <span class:list={{ minor: t.minor }} style={`--x: ${t.x}%`}>{t.label}</span>)}
              </div>
              <input
                class="temp__slider"
                id="temp-slider"
                type="range"
                min={toFahrenheit(COLDEST_C)}
                max={toFahrenheit(HOTTEST_C)}
                step="1"
                value={toFahrenheit(START_CELSIUS)}
                aria-label={`Temperature from ${COLDEST_C} to ${HOTTEST_C} °C`}
              />
              <div class="ticks ticks--metric" aria-hidden="true">
                {celsiusTicks.map((t) => <span class:list={{ minor: t.minor }} style={`--x: ${t.x}%`}>{t.label}</span>)}
              </div>
            </div>

            <div class="convert-table" id="temp-table" hidden>
              <table>
                <caption class="visually-hidden">Celsius to Fahrenheit</caption>
                <thead>
                  <tr><th scope="col">Celsius</th><th scope="col">Fahrenheit</th></tr>
                </thead>
                <tbody>
                  {temperatureTable.map(([c, f]) => <tr><td>{c}</td><td>{f}</td></tr>)}
                </tbody>
              </table>
            </div>
          </section>

          <section class="panel" aria-labelledby="cidr-title">
            <div class="panel__head">
              <h3 class="panel__title" id="cidr-title">Subnet</h3>
            </div>

            <div class="cidr">
              <label class="unit">
                <span class="unit__name">IP address</span>
                <span class="unit__box">
                  <input class="unit__input" id="cidr-ip" type="text" autocomplete="off" spellcheck="false" value={CIDR_START.ip} />
                </span>
              </label>
              <label class="unit">
                <span class="unit__name">Mask bits</span>
                <span class="unit__box">
                  <select class="unit__input" id="cidr-bits">
                    {maskOptions.map((m) => <option value={m.bits} selected={m.bits === CIDR_START.bits}>/{m.bits} · {m.netmask}</option>)}
                  </select>
                </span>
              </label>
            </div>

            <dl class="cidr__results">
              {
                cidrRows.map((row) => (
                  <div>
                    <dt>{row.label}</dt>
                    <dd id={`cidr-${row.key}`}>{cidrStart[row.key]}</dd>
                  </div>
                ))
              }
            </dl>
          </section>
        </div>
      </div>
    </dialog>
  </div>
</Base>

<script>
  import {
    formatOffset,
    formatWallTime,
    friendlyTime,
    instantFromWallTime,
    offsetMinutes,
    parseInZone,
    parseUnix,
    relativeTime,
    wallTime,
    zoneAbbreviation,
  } from '../lib/time';
  import {
    UNITS,
    formatNumber,
    fromMicrometers,
    metersToSlider,
    parseNumber,
    roundSignificant,
    sliderToMeters,
    toMicrometers,
    type Unit,
  } from '../lib/length';
  import { parseSuggestions, urlFromQuery } from '../lib/search';
  import { COLDEST_C, HOTTEST_C, formatTemperature, toCelsius, toFahrenheit } from '../lib/temperature';
  import { describeSubnet, formatIPv4, parseCidr } from '../lib/cidr';
  import { TIME_SOURCE, describeOffset, measureClockOffset } from '../lib/clock';

  const $ =<T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  // This is my new tab page, so everything opens right here rather than in another tab.
  const openHere = (href: string) => Object.assign(document.createElement('a'), { href, rel: 'noreferrer' }).click();

  /* ---------- Dialogs ---------- */

  // Conversions, and All zones on the time zone card.
  for (const id of ['conversions', 'zones']) {
    const dialog = $<HTMLDialogElement>(id);
    $(`${id}-open`).addEventListener('click', () => dialog.showModal());
    $(`${id}-close`).addEventListener('click', () => dialog.close());
    // A click on the backdrop lands on the dialog itself. Only close when the press started there too,
    // so letting go of a slider outside the dialog doesn't close it.
    let pressedBackdrop = false;
    dialog.addEventListener('pointerdown', (e) => (pressedBackdrop = e.target === dialog));
    dialog.addEventListener('click', (e) => {
      if (pressedBackdrop && e.target === dialog) dialog.close();
    });
  }

  /* ---------- Conversions ---------- */

  // Show Table / Hide Table on each converter.
  for (const toggle of document.querySelectorAll<HTMLButtonElement>('[data-table-toggle]')) {
    const table = $(toggle.getAttribute('aria-controls')!);
    toggle.addEventListener('click', () => {
      table.hidden = !table.hidden;
      toggle.setAttribute('aria-expanded', String(!table.hidden));
      toggle.textContent = table.hidden ? 'Show Table' : 'Hide Table';
      if (!table.hidden) table.scrollIntoView({ block: 'nearest' });
    });
  }

  /* ---------- Time zones ---------- */

  // The card and the All zones dialog show the same time, so each has its own rows, Unix field, Live
  // badge, Now button, and clock status.
  const rows = [...document.querySelectorAll<HTMLElement>('[data-zone]')].map((row) => ({
    tz: row.dataset.zone!,
    abbr: row.dataset.abbr,
    input: row.querySelector<HTMLInputElement>('[data-input]')!,
    slider: row.querySelector<HTMLInputElement>('[data-slider]')!,
    meta: row.querySelector<HTMLElement>('[data-meta]')!,
    friendly: row.querySelector<HTMLElement>('[data-friendly]')!,
  }));
  const unixRows = [...document.querySelectorAll<HTMLElement>('[data-unix]')].map((row) => ({
    input: row.querySelector<HTMLInputElement>('[data-input]')!,
    detail: row.querySelector<HTMLElement>('[data-detail]')!,
  }));
  const liveBadges = document.querySelectorAll<HTMLElement>('[data-live]');
  const clockStatuses = document.querySelectorAll<HTMLElement>('[data-clock]');

  // "Now" is this device's clock plus its measured offset from Akamai's time service. The offset is 0,
  // which means the device clock, until a sync succeeds or whenever the service can't be reached.
  let clockOffset = 0;
  const now = () => Date.now() + clockOffset;

  let instant = now();
  let live = true;
  // What a field showed when editing started, so partial input like "12" can't shift the base.
  let editBase = instant;

  /** Redraws everything except the field being typed in and the slider being dragged. */
  function renderTime(source?: Element) {
    const focused = document.activeElement;
    for (const row of rows) {
      const w = wallTime(instant, row.tz);
      const friendly = friendlyTime(instant, row.tz);
      if (row.input !== focused) {
        row.input.value = formatWallTime(w);
        row.input.removeAttribute('aria-invalid');
      }
      if (row.slider !== source) row.slider.value = String(w.hour * 60 + w.minute);
      row.slider.setAttribute('aria-valuetext', friendly);
      const abbr = zoneAbbreviation(instant, row.tz, row.abbr);
      const offset = formatOffset(offsetMinutes(instant, row.tz));
      row.meta.textContent = abbr ? `${abbr} · ${offset}` : offset;
      row.friendly.textContent = friendly;
    }
    for (const unix of unixRows) {
      if (unix.input !== focused) {
        unix.input.value = String(Math.floor(instant / 1000));
        unix.input.removeAttribute('aria-invalid');
      }
      unix.detail.textContent = `${instant} ms · ${relativeTime(instant, now())}`;
    }
    for (const badge of liveBadges) badge.hidden = !live;
  }

  /** Gets "now" from the time service again (on load and on every Now click), else the device clock. */
  async function syncClock() {
    for (const status of clockStatuses) {
      status.textContent = 'Syncing…';
      delete status.dataset.source;
    }
    const measured = await measureClockOffset();
    const host = new URL(TIME_SOURCE).host;
    clockOffset = measured?.offset ?? 0;
    for (const status of clockStatuses) {
      status.dataset.source = measured ? 'online' : 'device';
      status.textContent = measured ? 'Synced' : 'Device clock';
      status.title = measured
        ? `Time from ${host}; this device's clock is ${describeOffset(measured.offset)}.`
        : `Couldn't reach ${host}, so this is the device's clock.`;
    }
    tick();
  }

  function setInstant(next: number, source?: Element) {
    instant = next;
    live = false;
    renderTime(source);
  }

  /** Applies a typed value; blank or unparseable input leaves the time alone. */
  function applyTyped(input: HTMLInputElement, parse: () => number | null) {
    if (!input.value.trim()) return input.removeAttribute('aria-invalid');
    const next = parse();
    if (next === null) return input.setAttribute('aria-invalid', 'true');
    input.removeAttribute('aria-invalid');
    setInstant(next);
  }

  for (const row of rows) {
    row.input.addEventListener('focus', () => (editBase = instant));
    row.input.addEventListener('input', () => applyTyped(row.input, () => parseInZone(row.input.value, row.tz, editBase)));
    row.input.addEventListener('blur', () => renderTime());
    row.input.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter') return;
      row.input.value = formatWallTime(wallTime(instant, row.tz));
      row.input.removeAttribute('aria-invalid');
      editBase = instant;
    });

    row.slider.addEventListener('input', () => {
      const minutes = Number(row.slider.value);
      const w = wallTime(instant, row.tz);
      setInstant(instantFromWallTime({ ...w, hour: Math.floor(minutes / 60), minute: minutes % 60, second: 0 }, row.tz), row.slider);
    });
  }

  for (const { input } of unixRows) {
    input.addEventListener('input', () => applyTyped(input, () => parseUnix(input.value)));
    input.addEventListener('blur', () => renderTime());
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') input.value = String(Math.floor(instant / 1000));
    });
  }

  // Now stays clickable while live, since every click also asks the time service again.
  for (const button of document.querySelectorAll('[data-now]')) {
    button.addEventListener('click', () => {
      live = true;
      instant = now();
      renderTime();
      syncClock();
    });
  }

  function tick() {
    if (live) instant = now();
    renderTime();
  }

  // Tick on each second boundary so the seconds change in step with the (synced) clock.
  (function schedule() {
    setTimeout(() => {
      tick();
      schedule();
    }, 1000 - (now() % 1000) + 10);
  })();
  document.addEventListener('visibilitychange', () => document.visibilityState === 'visible' && tick());
  renderTime();
  syncClock();

  /* ---------- Length ---------- */

  const unitInputs = [...document.querySelectorAll<HTMLInputElement>('[data-unit]')].map((el) => ({
    unit: el.dataset.unit as Unit,
    el,
  }));
  const lengthSlider = $<HTMLInputElement>('len-slider');
  let micrometers = toMicrometers(1, 'm');
  // The unit last typed in; the slider rounds values in this unit.
  let activeUnit: Unit = 'm';

  /** Redraws every field except the one being typed in. */
  function renderLength(source?: Element) {
    for (const { unit, el } of unitInputs) {
      if (el === source) continue;
      el.value = formatNumber(fromMicrometers(micrometers, unit));
      el.removeAttribute('aria-invalid');
    }
    if (source !== lengthSlider) lengthSlider.value = String(metersToSlider(micrometers / 1e6));
    lengthSlider.setAttribute('aria-valuetext', `${formatNumber(fromMicrometers(micrometers, activeUnit))} ${activeUnit}`);
  }

  for (const { unit, el } of unitInputs) {
    el.addEventListener('focus', () => (activeUnit = unit));
    el.addEventListener('input', () => {
      if (!el.value.trim()) return el.removeAttribute('aria-invalid');
      const value = parseNumber(el.value);
      if (Number.isNaN(value)) return el.setAttribute('aria-invalid', 'true');
      el.removeAttribute('aria-invalid');
      micrometers = toMicrometers(value, unit);
      renderLength(el);
    });
    el.addEventListener('blur', () => renderLength());
  }

  lengthSlider.addEventListener('input', () => {
    const meters = sliderToMeters(Number(lengthSlider.value));
    const value = roundSignificant((meters * 1e6) / UNITS[activeUnit].um, 3);
    micrometers = toMicrometers(value, activeUnit);
    renderLength(lengthSlider);
  });

  renderLength();

  /* ---------- Temperature ---------- */

  const celsiusInput = $<HTMLInputElement>('temp-c');
  const fahrenheitInput = $<HTMLInputElement>('temp-f');
  const temperatureSlider = $<HTMLInputElement>('temp-slider');
  let celsius = parseNumber(celsiusInput.value);
  // The scale last typed in, Fahrenheit until then. The slider moves in whole degrees of it,
  // over the same span in both scales.
  let activeScale: 'c' | 'f' = 'f';

  /** Redraws the fields and slider, except the one being typed in or dragged. */
  function renderTemperature(source?: Element) {
    const shown: [HTMLInputElement, number][] = [
      [celsiusInput, celsius],
      [fahrenheitInput, toFahrenheit(celsius)],
    ];
    for (const [input, degrees] of shown) {
      if (input === source) continue;
      input.value = formatTemperature(degrees);
      input.removeAttribute('aria-invalid');
    }
    const onScale = activeScale === 'c' ? celsius : toFahrenheit(celsius);
    if (source !== temperatureSlider) temperatureSlider.value = String(onScale);
    temperatureSlider.setAttribute('aria-valuetext', `${formatTemperature(onScale)} °${activeScale.toUpperCase()}`);
  }

  for (const [input, scale] of [
    [celsiusInput, 'c'],
    [fahrenheitInput, 'f'],
  ] as const) {
    input.addEventListener('focus', () => {
      activeScale = scale;
      temperatureSlider.min = String(scale === 'c' ? COLDEST_C : toFahrenheit(COLDEST_C));
      temperatureSlider.max = String(scale === 'c' ? HOTTEST_C : toFahrenheit(HOTTEST_C));
      renderTemperature(input);
    });
    input.addEventListener('input', () => {
      if (!input.value.trim()) return input.removeAttribute('aria-invalid');
      const degrees = parseNumber(input.value);
      if (Number.isNaN(degrees)) return input.setAttribute('aria-invalid', 'true');
      input.removeAttribute('aria-invalid');
      celsius = scale === 'c' ? degrees : toCelsius(degrees);
      renderTemperature(input);
    });
    input.addEventListener('blur', () => renderTemperature());
  }

  temperatureSlider.addEventListener('input', () => {
    const degrees = Number(temperatureSlider.value);
    celsius = activeScale === 'c' ? degrees : toCelsius(degrees);
    renderTemperature(temperatureSlider);
  });

  renderTemperature();

  /* ---------- Subnet ---------- */

  const cidrInput = $<HTMLInputElement>('cidr-ip');
  const cidrBits = $<HTMLSelectElement>('cidr-bits');
  let cidrIp = parseCidr(cidrInput.value)!.ip;

  /** Redraws the results, and the address unless it's being typed in (a typed /prefix moves to the menu). */
  function renderSubnet(source?: Element) {
    if (source !== cidrInput) {
      cidrInput.value = formatIPv4(cidrIp);
      cidrInput.removeAttribute('aria-invalid');
    }
    for (const [key, text] of Object.entries(describeSubnet(cidrIp, Number(cidrBits.value)))) {
      $(`cidr-${key}`).textContent = text;
    }
  }

  cidrInput.addEventListener('input', () => {
    if (!cidrInput.value.trim()) return cidrInput.removeAttribute('aria-invalid');
    const parsed = parseCidr(cidrInput.value);
    if (!parsed) return cidrInput.setAttribute('aria-invalid', 'true');
    cidrInput.removeAttribute('aria-invalid');
    cidrIp = parsed.ip;
    if (parsed.bits !== null) cidrBits.value = String(parsed.bits);
    renderSubnet(cidrInput);
  });
  cidrInput.addEventListener('blur', () => renderSubnet());
  cidrBits.addEventListener('change', () => renderSubnet());

  /* ---------- Search ---------- */

  // A URL or domain in the Google box opens that site instead of searching for it.
  const googleInput = $<HTMLInputElement>('q-google');
  googleInput.form!.addEventListener('submit', (e) => {
    const url = urlFromQuery(googleInput.value);
    if (!url) return;
    e.preventDefault();
    openHere(url);
  });

  // YouTube opens as a link rather than a form submission, like the prompt boxes, so the CSP's
  // form-action can stay narrow.
  const youtubeInput = $<HTMLInputElement>('q-youtube');
  youtubeInput.form!.addEventListener('submit', (e) => {
    e.preventDefault();
    openHere('https://www.youtube.com/results?search_query=' + encodeURIComponent(youtubeInput.value.trim()));
  });

  // Each search box suggests searches as I type, like the engine's own. Google and DuckDuckGo don't let
  // other sites read their suggestions, so they come through /tools/suggest/ on this domain (see
  // SuggestFunction in infra/site.yaml), and the CSP's connect-src stays at 'self'.
  for (const input of document.querySelectorAll<HTMLInputElement>('[data-suggest]')) {
    const list = document.createElement('ul');
    list.className = 'suggest';
    list.id = `${input.id}-suggestions`;
    list.hidden = true;
    list.setAttribute('role', 'listbox');
    list.setAttribute('aria-label', `${input.labels![0].textContent} suggestions`);
    input.form!.append(list);
    input.setAttribute('role', 'combobox');
    input.setAttribute('aria-autocomplete', 'list');
    input.setAttribute('aria-controls', list.id);
    input.setAttribute('aria-expanded', 'false');

    // What I typed, which comes back when the highlight moves off the suggestions.
    let typed = '';
    let active = -1;
    let request: AbortController | undefined;

    function highlight(index: number) {
      const options = [...list.children];
      active = index;
      options.forEach((option, i) => option.setAttribute('aria-selected', String(i === index)));
      if (index < 0) input.removeAttribute('aria-activedescendant');
      else input.setAttribute('aria-activedescendant', options[index].id);
      input.value = index < 0 ? typed : options[index].textContent!;
    }

    function show(suggestions: string[]) {
      list.replaceChildren(
        ...suggestions.slice(0, 8).map((text, i) => {
          const option = document.createElement('li');
          option.id = `${list.id}-${i}`;
          option.textContent = text;
          option.setAttribute('role', 'option');
          option.setAttribute('aria-selected', 'false');
          return option;
        }),
      );
      active = -1;
      input.removeAttribute('aria-activedescendant');
      list.hidden = !list.children.length;
      input.setAttribute('aria-expanded', String(!list.hidden));
    }

    function close() {
      request?.abort();
      show([]);
    }

    input.addEventListener('input', async () => {
      typed = input.value;
      request?.abort();
      if (!typed.trim()) return show([]);
      request = new AbortController();
      try {
        const response = await fetch(`/tools/suggest/${input.dataset.suggest}?q=${encodeURIComponent(typed)}`, {
          signal: request.signal,
        });
        show(parseSuggestions(await response.json()));
      } catch {
        // Replaced by the next keystroke, or offline: no suggestions, and searching still works.
      }
    });

    input.addEventListener('keydown', (e) => {
      if (list.hidden || e.isComposing) return;
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        // Past either end, the highlight goes back to what I typed, as in Google's own box.
        const slots = list.children.length + 1;
        highlight(((active + 1 + (e.key === 'ArrowDown' ? 1 : -1) + slots) % slots) - 1);
      } else if (e.key === 'Escape') {
        // Only closes the suggestions. With none open, Escape clears the box as usual.
        e.preventDefault();
        highlight(-1);
        close();
      }
    });

    input.addEventListener('blur', close);
    input.form!.addEventListener('submit', close);
    // Pressing on a suggestion would otherwise take focus from the box and close the list before the click.
    list.addEventListener('mousedown', (e) => e.preventDefault());
    list.addEventListener('click', (e) => {
      const option = (e.target as Element).closest('li');
      if (!option) return;
      input.value = option.textContent!;
      input.form!.requestSubmit();
    });
  }

  /* ---------- Assistants ---------- */

  // Enter sends and Shift+Enter starts a new line, as in ChatGPT and Gemini themselves. The prompt
  // opens as a link rather than a form submission, so the CSP's form-action can stay narrow.
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-prompt-url]')) {
    const prompt = form.querySelector('textarea')!;
    prompt.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter' || e.shiftKey || e.isComposing) return;
      e.preventDefault();
      form.requestSubmit();
    });
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const text = prompt.value.trim();
      if (text) openHere(form.dataset.promptUrl + encodeURIComponent(text));
    });
  }
</script>

<style>
  /* Spaced to fit a 900px-tall window without scrolling. */
  .tools {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-block: 1.25rem;
  }

  /* Tool buttons along the top right, starting with Conversions. */
  .topbar {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem;
  }

  /* Panels */
  .panel {
    padding: clamp(1rem, 2vw, 1.375rem) clamp(1.125rem, 2.5vw, 1.75rem);
    border: 1px solid var(--line);
    border-radius: 16px;
    background: rgb(11 17 27 / 0.72);
  }

  /* The title keeps its width, and on a phone the actions wrap onto a second line beside it. */
  .panel__head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0 1rem;
    margin-bottom: 0.75rem;
  }

  .panel__title {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .panel__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: 0.5rem 0.875rem;
  }

  .panel__hint {
    grid-column: 1 / -1;
    margin-top: 0.125rem;
    color: var(--text-3);
    font-size: 0.8125rem;
  }

  kbd {
    white-space: nowrap;
    padding: 0.05rem 0.35rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--bg-input);
    color: var(--text-2);
    font-family: var(--mono);
    font-size: 0.75rem;
  }

  .button--small {
    min-height: 2rem;
    padding: 0.25rem 0.875rem;
    font-size: 0.8125rem;
  }

  .live {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--teal);
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* Where "now" comes from: synced with the time service, or this device's clock when it can't be reached. */
  .clock {
    color: var(--text-3);
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: help;
  }

  .clock[data-source='device'] {
    color: var(--amber);
  }

  .live[hidden] {
    display: none;
  }

  .live__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--teal);
    box-shadow: 0 0 0 3px var(--teal-wash);
  }

  /* Shared input look */
  .field,
  .unit__box {
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--bg-input);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .field {
    width: 100%;
    min-width: 0;
    padding: 0.5rem 0.75rem;
    color: var(--text);
    font-family: var(--mono);
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums;
  }

  .field:focus,
  .unit__box:focus-within {
    outline: none;
    border-color: var(--teal);
    box-shadow: 0 0 0 3px var(--teal-wash);
  }

  .field[aria-invalid='true'],
  .unit__box:has(input[aria-invalid='true']) {
    border-color: var(--danger);
    box-shadow: 0 0 0 3px rgb(242 139 125 / 0.12);
  }

  /* Time zones */
  .tz {
    --label: 9.5rem;
    --input: 14.25rem;
    --friendly: 10.5rem;
    display: flex;
    flex-direction: column;
  }

  .tz__row {
    display: grid;
    grid-template-columns: var(--label) var(--input) var(--friendly) minmax(0, 1fr);
    align-items: center;
    gap: 0.5rem 1.25rem;
    padding-block: 0.5rem;
  }

  .tz__row + .tz__row:not(.tz__row--ticks) {
    border-top: 1px solid var(--line);
  }

  .tz__row--ticks {
    padding-block: 0 0.5rem;
  }

  .tz__row--unix {
    margin-top: 0.25rem;
  }

  .tz__label {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }

  .tz__label label {
    font-weight: 600;
  }

  .tz__meta {
    color: var(--text-3);
    font-family: var(--mono);
    font-size: 0.75rem;
  }

  .tz__friendly {
    color: var(--text-2);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .tz__row--unix .tz__unix-detail {
    grid-column: 3 / -1;
  }

  .tz__unix-detail {
    color: var(--text-3);
    font-family: var(--mono);
    font-size: 0.8125rem;
    white-space: normal;
  }

  /* Range inputs */
  input[type='range'] {
    --thumb-w: 10px;
    width: 100%;
    height: 26px;
    margin: 0;
    background: transparent;
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
  }

  input[type='range']:focus-visible {
    outline: none;
  }

  input[type='range']::-webkit-slider-runnable-track {
    box-sizing: border-box;
    height: 10px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--track, var(--bg-input));
  }

  input[type='range']::-moz-range-track {
    box-sizing: border-box;
    height: 10px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--track, var(--bg-input));
  }

  input[type='range']::-webkit-slider-thumb {
    box-sizing: border-box;
    width: var(--thumb-w);
    height: 22px;
    margin-top: -7px;
    border: 2px solid var(--bg);
    border-radius: 999px;
    background: var(--text);
    box-shadow: 0 0 0 1px var(--line-strong), 0 2px 8px rgb(0 0 0 / 0.5);
    -webkit-appearance: none;
    appearance: none;
  }

  input[type='range']::-moz-range-thumb {
    box-sizing: border-box;
    width: var(--thumb-w);
    height: 22px;
    border: 2px solid var(--bg);
    border-radius: 999px;
    background: var(--text);
    box-shadow: 0 0 0 1px var(--line-strong), 0 2px 8px rgb(0 0 0 / 0.5);
  }

  input[type='range']:hover::-webkit-slider-thumb,
  input[type='range']:focus-visible::-webkit-slider-thumb {
    background: var(--teal-bright);
    box-shadow: 0 0 0 4px var(--teal-wash), 0 2px 8px rgb(0 0 0 / 0.5);
  }

  input[type='range']:hover::-moz-range-thumb,
  input[type='range']:focus-visible::-moz-range-thumb {
    background: var(--teal-bright);
    box-shadow: 0 0 0 4px var(--teal-wash), 0 2px 8px rgb(0 0 0 / 0.5);
  }

  /* Night, twilight, and working hours (9 to 5) along each day. */
  .tz__slider {
