---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Linked from '../components/Linked.astro';
import { getProjects } from '../lib/content';
import { profile } from '../lib/profile';

const projects = await Promise.all(
  (await getProjects()).map(async (project) => ({ project, Content: (await render(project)).Content })),
);
---

<Base title="Projects" description="Selected initiatives: platform engineering, hosting, billing systems, AWS, security and compliance, and client software.">
  <header class="page-head">
    <div class="container">
      <p class="eyebrow eyebrow--teal">Projects</p>
      <h1>Selected initiatives</h1>
      <p class="lede">Platforms, programs, and systems I've designed, built, or led. Client details are kept abstract on purpose.</p>
    </div>
  </header>

  {
    projects.map(({ project, Content }) => (
      <section class="section" id={project.id} aria-labelledby={`${project.id}-title`}>
        <div class="container row">
          <div class="project__side">
            <p class="eyebrow eyebrow--teal">
              {project.data.area}
              {project.data.draft && <span class="badge">Draft</span>}
            </p>
            <h2 id={`${project.id}-title`}>{project.data.title}</h2>
            <ul class="tags" aria-label="Stack">
              {project.data.stack.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
          <div>
            <p class="project__summary">
              <Linked text={project.data.summary} />
            </p>
            <div class="prose project__body">
              <Content />
            </div>
          </div>
        </div>
      </section>
    ))
  }

  {
    profile.alsoWorkedOn.length > 0 && (
      <section class="section" aria-labelledby="also">
        <div class="container row">
          <h2 class="eyebrow" id="also">Also</h2>
          <ul class="also">
            {profile.alsoWorkedOn.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</Base>

<style>
  .project__side {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .project__side .eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .project__side h2 {
    font-size: 1.375rem;
    letter-spacing: -0.02em;
  }

  .project__summary {
    max-width: 42rem;
    font-size: 1.1875rem;
    line-height: 1.6;
  }

  .project__body {
    margin-top: 1.25rem;
  }

  section:target > .container {
    border-top-color: var(--teal);
  }

  .also {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    padding: 0;
    list-style: none;
  }

  .also li {
    padding: 0.375rem 0.875rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--text-2);
    font-size: 0.9375rem;
  }
</style>
