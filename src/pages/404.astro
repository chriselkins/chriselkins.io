---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" noindex>
  <header class="page-head">
    <div class="container">
      <p class="eyebrow eyebrow--teal">404</p>
      <h1>That page doesn't exist.</h1>
      <p class="lede">It may have moved, or the link may have a typo.</p>
      <p class="back">
        <a class="arrow-link" href="/"><span aria-hidden="true">←</span> Back to the home page</a>
      </p>
    </div>
  </header>
</Base>

<style>
  .back {
    margin-top: 2rem;
  }
</style>
