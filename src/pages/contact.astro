---
import Base from '../layouts/Base.astro';
import Linked from '../components/Linked.astro';
import { profile } from '../lib/profile';

const channels = [
  { label: 'LinkedIn', note: 'The best way to reach me', href: profile.links.linkedin, external: true },
  ...(profile.email ? [{ label: 'Email', note: profile.email, href: `mailto:${profile.email}`, external: false }] : []),
  { label: 'GitHub', note: new URL(profile.links.github).pathname.slice(1), href: profile.links.github, external: true },
];
---

<Base title="Contact" description={`Get in touch with ${profile.name}.`}>
  <header class="page-head">
    <div class="container">
      <p class="eyebrow eyebrow--teal">Contact</p>
      <h1>Let's connect</h1>
      <p class="lede"><Linked text={profile.contact} /></p>
    </div>
  </header>

  <section class="section" aria-label="Ways to reach me">
    <div class="container">
      <ul role="list" class="channels">
        {
          channels.map((c) => (
            <li>
              <a class="channel" href={c.href} rel={c.external ? 'me noopener' : undefined}>
                <span class="channel__label">{c.label}</span>
                <span class="channel__note">{c.note}</span>
                <span class="channel__arrow" aria-hidden="true">
                  {c.external ? '↗' : '→'}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .channels {
    max-width: 44rem;
    border-top: 1px solid var(--line);
  }

  .channel {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.25rem 1.5rem;
    padding-block: 1.375rem;
    border-bottom: 1px solid var(--line);
    transition: color 0.15s ease;
  }

  .channel__label {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .channel__note {
    color: var(--text-2);
  }

  .channel__arrow {
    color: var(--teal);
    transition: transform 0.15s ease;
  }

  .channel:hover .channel__label {
    color: var(--teal-bright);
  }

  .channel:hover .channel__arrow {
    transform: translate(2px, -2px);
  }

  @media (max-width: 560px) {
    .channel {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .channel__note {
      grid-row: 2;
    }
  }
</style>
